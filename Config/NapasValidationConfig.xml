<?xml version="1.0" encoding="utf-8"?>
<NapasValidationConfiguration>
  <DataElements>
    <!-- DE#2 -->
    <DataElement Number="2" Name="DE2_PAN" Description="Primary Account Number (PAN)">
      <MinLength>9</MinLength>
      <MaxLength>19</MaxLength>
      <DataType>AN</DataType>
      <Pattern>^[0-9]{9,19}$</Pattern>
      <RequiredIn>0200,0210,0400,0410,0420,0430</RequiredIn>
      <ErrorCode>14</ErrorCode>
      <ErrorMessage>Invalid card number - PAN must be 9-19 numeric digits</ErrorMessage>
    </DataElement>

    <!-- DE#3-->
    <DataElement Number="3" Name="DE3_ProcessingCode" Description="Processing Code">
      <MinLength>6</MinLength>
      <MaxLength>6</MaxLength>
      <DataType>AN</DataType>
      <Pattern>^[0-9]{6}$</Pattern>
      <RequiredIn>0200,0210,0400,0410,0420,0430</RequiredIn>
      <ErrorCode>40</ErrorCode>
      <ErrorMessage>Invalid processing code - must be 6 numeric digits</ErrorMessage>
      <AllowedValues>
        <Value>000000</Value> <!-- Purchase -->
        <Value>010000</Value> <!-- Cash Withdrawal -->
        <Value>020000</Value> <!-- Adjustment/Void -->
        <Value>090000</Value> <!-- Cash Deposit -->
        <Value>300000</Value> <!-- Balance Inquiry -->
      </AllowedValues>
    </DataElement>

    <!-- DE#4 -->
    <DataElement Number="4" Name="DE4_Amount" Description="Transaction amount">
      <MinLength>12</MinLength>
      <MaxLength>12</MaxLength>
      <DataType>N</DataType>
      <Pattern>^[0-9]{12}$</Pattern>
      <RequiredIn>0200,0210,0400,0410</RequiredIn>
      <ErrorCode>13</ErrorCode>
      <ErrorMessage>Invalid amount - must be 12 numeric digits</ErrorMessage>
    </DataElement>

    <!-- DE#7 -->
    <DataElement Number="7" Name="DE7_TransmissionDateTime" Description="MMddHHmmss format">
      <MinLength>10</MinLength>
      <MaxLength>10</MaxLength>
      <DataType>N</DataType>
      <Pattern>^(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])(0[0-9]|1[0-9]|2[0-3])[0-5][0-9][0-5][0-9]$</Pattern>
      <RequiredIn></RequiredIn>
      <ErrorCode>30</ErrorCode>
      <ErrorMessage>Invalid transmission date/time - format MMddHHmmss</ErrorMessage>
    </DataElement>

    <!-- DE#9 -->
    <DataElement Number="9" Name="" Description="">
      <MinLength>8</MinLength>
      <MaxLength>8</MaxLength>
      <DataType>N</DataType>
      <Pattern>^[0-9]{8}$</Pattern>
      <RequiredIn></RequiredIn>
      <ErrorCode>30</ErrorCode>
      <ErrorMessage>Invalid settlement conversion rate - must be 8 numeric digits</ErrorMessage>
    </DataElement>

    <!-- DE#10 -->
    <DataElement Number="10" Name="" Description="">
      <MinLength>8</MinLength>
      <MaxLength>8</MaxLength>
      <DataType>N</DataType>
      <Pattern>^[0-9]{8}$</Pattern>
      <RequiredIn></RequiredIn>
      <ErrorCode>30</ErrorCode>
      <ErrorMessage>Invalid billing conversion rate - must be 8 numeric digits</ErrorMessage>
    </DataElement>                                                                                                                                                          

    <!-- DE#11 -->
    <DataElement Number="11" Name="DE11_STAN" Description="System Trace Audit Number">
      <MinLength>6</MinLength>
      <MaxLength>6</MaxLength>
      <DataType>N</DataType>
      <Pattern>^[0-9]{6}$</Pattern>
      <RequiredIn>0200,0210,0400,0410,0420,0430,0800,0810</RequiredIn>
      <ErrorCode>96</ErrorCode>
      <ErrorMessage>Invalid STAN - must be 6 numeric digits</ErrorMessage>
    </DataElement>

    <!-- DE#12 -->
    <DataElement Number="12" Name="DE12_LocalTime" Description="HHmmss format">
      <MinLength>6</MinLength>
      <MaxLength>6</MaxLength>
      <DataType>N</DataType>
      <Pattern>^(0[0-9]|1[0-9]|2[0-3])[0-5][0-9][0-5][0-9]$</Pattern>
      <RequiredIn>0200,0210,0400,0410,0420,0430</RequiredIn>
      <ErrorCode>30</ErrorCode>
      <ErrorMessage>Invalid local time - format HHmmss</ErrorMessage>
    </DataElement>

    <!-- DE#13 -->
    <DataElement Number="13" Name="DE13_LocalDate" Description="MMDD format">
      <MinLength>4</MinLength>
      <MaxLength>4</MaxLength>
      <DataType>N</DataType>
      <Pattern>^(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])$</Pattern>
      <RequiredIn>0200,0210,0400,0410,0420,0430</RequiredIn>
      <ErrorCode>30</ErrorCode>
      <ErrorMessage>Invalid local date - format MMDD</ErrorMessage>
    </DataElement>

    <!-- DE#14 -->
    <DataElement Number="14" Name="" Description="">
      <MinLength>4</MinLength>
      <MaxLength>4</MaxLength>
      <DataType>N</DataType>
      <Pattern>^[0-9]{4}$</Pattern>
      <RequiredIn></RequiredIn>
      <ErrorCode>54</ErrorCode>
      <ErrorMessage>Invalid expiration date - must be YYMM</ErrorMessage>
    </DataElement>

    <!-- DE#15 -->
    <DataElement Number="15" Name="DE15_SettlementDate" Description="MMDD format">
      <MinLength>4</MinLength>
      <MaxLength>4</MaxLength>
      <DataType>N</DataType>
      <Pattern>^[0-9]{4}$</Pattern>
