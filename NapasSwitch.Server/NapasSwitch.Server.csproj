<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Components\NapasSwitch.Data\NapasSwitch.Data.csproj" />
    <ProjectReference Include="..\Components\NapasSwitch.Network\NapasSwitch.Network.csproj" />
